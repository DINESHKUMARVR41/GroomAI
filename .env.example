# YouCam AI hairstyle/beard try-on (optional for booking app)
YOUCAM_API_KEY=PASTE_YOUR_YOUCAM_API_KEY_HERE
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# IMPORTANT: change these demo credentials before public deployment.
GROOMAI_SESSION_SECRET=replace-this-with-a-long-random-secret-before-deploying
BARBER_USERNAME=barber@groomai.local
BARBER_PASSWORD=Barber@12345
ADMIN_USERNAME=admin@groomai.local
ADMIN_PASSWORD=GroomAI@12345

# Optional Google Sign-In. Create a Google OAuth Web client ID and add its authorized JavaScript origin.
# For local testing use http://127.0.0.1:8000 and http://localhost:8000 as authorized origins.
GOOGLE_CLIENT_ID=
# Set COOKIE_SECURE=1 only when the app is served over HTTPS.
COOKIE_SECURE=0
