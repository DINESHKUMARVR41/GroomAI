# Copy this file to .env and replace the placeholder with your own YouCam API key.
# The private .env file is intentionally excluded from ZIPs and Git.
YOUCAM_API_KEY=PASTE_YOUR_YOUCAM_API_KEY_HERE
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Optional: Gemini image analysis for style compatibility recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
